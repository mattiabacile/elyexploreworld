{
  "$schema": "https://unpkg.com/@sveltia/cms@0.229.0/schema/sveltia-cms.json",
  "app_title": "ElyExploreWorld · Racconti",
  "backend": {
    "name": "github",
    "repo": "mattiabacile/elyexploreworld",
    "branch": "main",
    "base_url": "https://elyexploreworld.pages.dev",
    "auth_methods": [
      "token"
    ],
    "commit_messages": {
      "create": "Nuovo racconto: {{slug}}",
      "update": "Aggiorna racconto: {{slug}}",
      "delete": "Rimuovi racconto: {{slug}}",
      "uploadMedia": "Aggiungi foto: {{path}}",
      "deleteMedia": "Rimuovi foto: {{path}}"
    },
    "api_root": "https://elyexploreworld.pages.dev/cms/api/v3",
    "graphql_api_root": "https://elyexploreworld.pages.dev/cms/api/graphql"
  },
  "site_url": "https://elyexploreworld.pages.dev",
  "display_url": "https://elyexploreworld.pages.dev",
  "publish_mode": "simple",
  "media_folder": "assets/uploads",
  "public_folder": "/assets/uploads",
  "show_preview_links": true,
  "media_libraries": {
    "default": {
      "config": {
        "max_file_size": 25000000,
        "slugify_filename": true,
        "filename_template": "{{slug}}-{{uuid_short}}",
        "transformations": {
          "raster_image": {
            "format": "webp",
            "quality": 88,
            "width": 2400,
            "height": 2400
          }
        }
      }
    }
  },
  "collections": [
    {
      "name": "racconti",
      "label": "Racconti e consigli",
      "label_singular": "Racconto",
      "description": "Il tuo taccuino di viaggio: raccogli ricordi, scegli le fotografie e condividi un nuovo racconto.",
      "file": "content/stories.json",
      "format": "json",
      "create": true,
      "delete": true,
      "duplicate": false,
      "identifier_field": "title",
      "summary": "{{title}} · {{destination}}",
      "thumbnail": "hero",
      "sortable_fields": [
        "date",
        "title",
        "destination",
        "published"
      ],
      "preview_path": "racconto.html?story={{fields.id}}",
      "fields": [
        {
          "name": "title",
          "label": "Titolo",
          "widget": "richtext",
          "minimal": true,
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic"
          ],
          "editor_components": [],
          "use_emoji_autocomplete": false
        },
        {
          "name": "kind",
          "label": "Tipo di contenuto",
          "widget": "select",
          "default": "racconto",
          "options": [
            {
              "label": "Racconto di viaggio",
              "value": "racconto"
            },
            {
              "label": "Consiglio di viaggio",
              "value": "consiglio"
            }
          ]
        },
        {
          "name": "date",
          "label": "Data del racconto",
          "widget": "datetime",
          "type": "date",
          "format": "YYYY-MM-DD",
          "date_format": "DD/MM/YYYY",
          "time_format": false,
          "hint": "I racconti sono ordinati dal più recente. La data non programma una pubblicazione futura.",
          "default": "{{now}}"
        },
        {
          "name": "destination",
          "label": "Destinazione",
          "widget": "string",
          "maxlength": 70,
          "hint": "Nome del luogo mostrato nello slideshow della homepage."
        },
        {
          "name": "deck",
          "label": "Introduzione breve",
          "widget": "richtext",
          "hint": "Testo mostrato sotto il titolo e nelle schede dell’archivio.",
          "minimal": true,
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic",
            "link"
          ],
          "editor_components": [],
          "use_emoji_autocomplete": false
        },
        {
          "name": "hero",
          "label": "Foto di copertina",
          "widget": "image",
          "choose_url": false,
          "accept": "image/jpeg,image/png,image/webp,image/avif,image/heic",
          "hint": "Preferisci una foto orizzontale. Verrà ottimizzata per il web durante il caricamento."
        },
        {
          "name": "heroAlt",
          "label": "Descrizione della foto",
          "widget": "string",
          "hint": "Descrivi cosa si vede: aiuta chi utilizza un lettore dello schermo."
        },
        {
          "name": "heroCaption",
          "label": "Didascalia della copertina",
          "widget": "richtext",
          "required": false,
          "minimal": true,
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic",
            "link"
          ],
          "editor_components": [],
          "use_emoji_autocomplete": false
        },
        {
          "name": "intro",
          "label": "Apertura del racconto",
          "widget": "richtext",
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic",
            "link",
            "heading-two",
            "heading-three",
            "bulleted-list",
            "numbered-list",
            "quote"
          ],
          "editor_components": [
            "image"
          ],
          "hint": "Testo iniziale dell’articolo. I capitoli sono facoltativi."
        },
        {
          "name": "chapters",
          "label": "Capitoli",
          "widget": "list",
          "required": false,
          "collapsed": true,
          "summary": "{{fields.title}}",
          "label_singular": "Capitolo",
          "hint": "Per un articolo lungo, aggiungi sezioni con testo e foto. Trascinale per cambiare l’ordine.",
          "fields": [
            {
              "name": "title",
              "label": "Titolo del capitolo",
              "widget": "richtext",
              "minimal": true,
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic"
              ],
              "editor_components": [],
              "use_emoji_autocomplete": false
            },
            {
              "name": "body",
              "label": "Testo del capitolo",
              "widget": "richtext",
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic",
                "link",
                "heading-two",
                "heading-three",
                "bulleted-list",
                "numbered-list",
                "quote"
              ],
              "editor_components": [
                "image"
              ]
            },
            {
              "name": "layout",
              "label": "Disposizione del capitolo",
              "widget": "select",
              "options": [
                {
                  "label": "Alternanza automatica",
                  "value": "auto"
                },
                {
                  "label": "Foto a destra del testo",
                  "value": "right"
                },
                {
                  "label": "Foto a sinistra del testo",
                  "value": "left"
                },
                {
                  "label": "Foto grande sotto il testo",
                  "value": "wide"
                }
              ],
              "default": "auto"
            },
            {
              "name": "image",
              "label": "Foto del capitolo",
              "widget": "image",
              "choose_url": false,
              "accept": "image/jpeg,image/png,image/webp,image/avif,image/heic",
              "required": false
            },
            {
              "name": "imageFormat",
              "label": "Formato della foto",
              "widget": "select",
              "options": [
                {
                  "label": "Automatico",
                  "value": "auto"
                },
                {
                  "label": "Orizzontale",
                  "value": "landscape"
                },
                {
                  "label": "Verticale",
                  "value": "portrait"
                },
                {
                  "label": "Quadrato",
                  "value": "square"
                },
                {
                  "label": "Foto intera, senza ritaglio",
                  "value": "natural"
                }
              ],
              "default": "auto"
            },
            {
              "name": "imageAlt",
              "label": "Descrizione della foto",
              "widget": "string",
              "required": false
            },
            {
              "name": "caption",
              "label": "Didascalia",
              "widget": "richtext",
              "required": false,
              "minimal": true,
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic",
                "link"
              ],
              "editor_components": [],
              "use_emoji_autocomplete": false
            },
            {
              "name": "quote",
              "label": "Citazione",
              "widget": "richtext",
              "required": false,
              "minimal": true,
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic",
                "link"
              ],
              "editor_components": [],
              "use_emoji_autocomplete": false
            },
            {
              "name": "note",
              "label": "Consiglio pratico: Da sapere",
              "widget": "richtext",
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic",
                "link",
                "heading-two",
                "heading-three",
                "bulleted-list",
                "numbered-list",
                "quote"
              ],
              "editor_components": [
                "image"
              ],
              "required": false
            }
          ]
        },
        {
          "name": "travelFacts",
          "label": "Informazioni del viaggio",
          "widget": "object",
          "required": false,
          "collapsed": true,
          "hint": "Facoltative. Compariranno sotto la copertina, prima del racconto.",
          "fields": [
            {
              "name": "duration",
              "label": "Durata",
              "widget": "string",
              "required": false,
              "hint": "Esempio: 10 giorni."
            },
            {
              "name": "season",
              "label": "Quando partire",
              "widget": "string",
              "required": false,
              "hint": "Esempio: aprile e maggio."
            },
            {
              "name": "style",
              "label": "Tipo di viaggio",
              "widget": "string",
              "required": false,
              "hint": "Esempio: città e natura, in coppia."
            }
          ]
        },
        {
          "name": "category",
          "label": "Categoria",
          "widget": "string",
          "required": false,
          "hint": "Esempio: Natura e cultura."
        },
        {
          "name": "tags",
          "label": "Tag",
          "widget": "list",
          "required": false,
          "hint": "Esempio: Bali, Indonesia, Natura.",
          "field": {
            "name": "tag",
            "label": "Tag",
            "widget": "string"
          },
          "collapsed": true,
          "summary": "{{fields.tag}}"
        },
        {
          "name": "gallery",
          "label": "Galleria fotografica",
          "label_singular": "Foto",
          "widget": "list",
          "required": false,
          "collapsed": true,
          "summary": "{{fields.caption}}",
          "thumbnail": "image",
          "hint": "Una raccolta di foto alla fine dell’articolo. Puoi cambiarne l’ordine trascinandole.",
          "fields": [
            {
              "name": "image",
              "label": "Foto",
              "widget": "image",
              "choose_url": false,
              "accept": "image/jpeg,image/png,image/webp,image/avif,image/heic"
            },
            {
              "name": "alt",
              "label": "Descrizione della foto",
              "widget": "string",
              "hint": "Descrivi cosa si vede nella foto."
            },
            {
              "name": "caption",
              "label": "Didascalia",
              "widget": "richtext",
              "required": false,
              "minimal": true,
              "modes": [
                "rich_text"
              ],
              "buttons": [
                "bold",
                "italic",
                "link"
              ],
              "editor_components": [],
              "use_emoji_autocomplete": false
            }
          ]
        },
        {
          "name": "conclusion",
          "label": "Conclusione",
          "widget": "richtext",
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic",
            "link",
            "heading-two",
            "heading-three",
            "bulleted-list",
            "numbered-list",
            "quote"
          ],
          "editor_components": [
            "image"
          ],
          "hint": "Testo mostrato alla fine dell’articolo.",
          "required": false
        },
        {
          "name": "appearance",
          "label": "Aspetto dell’articolo",
          "widget": "object",
          "required": true,
          "collapsed": true,
          "summary": "Colori, copertina e lettura",
          "fields": [
            {
              "name": "theme",
              "label": "Colore dei dettagli",
              "widget": "select",
              "options": [
                {
                  "label": "Argilla",
                  "value": "clay"
                },
                {
                  "label": "Verde foresta",
                  "value": "forest"
                },
                {
                  "label": "Blu oceano",
                  "value": "ocean"
                }
              ],
              "default": "clay"
            },
            {
              "name": "coverFormat",
              "label": "Formato della copertina",
              "widget": "select",
              "options": [
                {
                  "label": "Panoramica",
                  "value": "panoramic"
                },
                {
                  "label": "Orizzontale classica",
                  "value": "landscape"
                },
                {
                  "label": "Foto intera, senza ritaglio",
                  "value": "natural"
                }
              ],
              "default": "panoramic"
            },
            {
              "name": "coverPosition",
              "label": "Punto del ritaglio",
              "widget": "select",
              "options": [
                {
                  "label": "Centro",
                  "value": "center"
                },
                {
                  "label": "Parte alta",
                  "value": "top"
                },
                {
                  "label": "Parte bassa",
                  "value": "bottom"
                }
              ],
              "default": "center",
              "hint": "Agisce sulla copertina dell’articolo."
            },
            {
              "name": "textStyle",
              "label": "Stile del testo",
              "widget": "select",
              "options": [
                {
                  "label": "Contemporaneo",
                  "value": "modern"
                },
                {
                  "label": "Diario di viaggio",
                  "value": "journal"
                }
              ],
              "default": "modern"
            },
            {
              "name": "dropCap",
              "label": "Iniziale grande nel primo paragrafo",
              "widget": "boolean",
              "default": true
            },
            {
              "name": "showContents",
              "label": "Sommario con link ai capitoli",
              "widget": "boolean",
              "default": false,
              "hint": "Compare quando ci sono almeno due capitoli."
            }
          ],
          "default": {
            "theme": "clay",
            "coverFormat": "panoramic",
            "coverPosition": "center",
            "textStyle": "modern",
            "dropCap": true,
            "showContents": false
          }
        },
        {
          "name": "titleAccent",
          "label": "Parola del titolo in corsivo",
          "widget": "hidden",
          "required": false
        },
        {
          "name": "slideText",
          "label": "Testo breve dello slideshow",
          "widget": "richtext",
          "required": false,
          "hint": "Facoltativo: una o due frasi per la homepage. Se lasci il campo vuoto, viene usata l’introduzione breve.",
          "minimal": true,
          "modes": [
            "rich_text"
          ],
          "buttons": [
            "bold",
            "italic",
            "link"
          ],
          "editor_components": [],
          "use_emoji_autocomplete": false
        },
        {
          "name": "published",
          "label": "Visibile sul sito",
          "widget": "boolean",
          "default": false,
          "hint": "Attiva per rendere il racconto visibile dopo Salva. Lascia disattivato per salvare una bozza fuori dal sito."
        },
        {
          "name": "preparing",
          "label": "Consiglio in preparazione",
          "widget": "boolean",
          "default": false,
          "hint": "Solo per i consigli: pubblica una scheda di anteprima, senza aprire l’articolo completo."
        },
        {
          "name": "id",
          "widget": "hidden",
          "default": "{{uuid}}"
        }
      ],
      "view_filters": [
        {
          "label": "Bozze",
          "field": "published",
          "pattern": "false"
        },
        {
          "label": "Pubblicati",
          "field": "published",
          "pattern": "true"
        },
        {
          "label": "Racconti di viaggio",
          "field": "kind",
          "pattern": "racconto"
        },
        {
          "label": "Consigli di viaggio",
          "field": "kind",
          "pattern": "consiglio"
        },
        {
          "label": "Consigli in preparazione",
          "field": "preparing",
          "pattern": "true"
        }
      ]
    }
  ],
  "asset_collections": [
    {
      "name": "foto-esistenti",
      "label": "Foto già presenti nel sito",
      "media_folder": "assets/stories",
      "public_folder": "/assets/stories",
      "readonly": true
    }
  ]
}
